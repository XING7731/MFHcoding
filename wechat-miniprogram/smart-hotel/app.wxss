/**
 * app.wxss —— 全局样式
 * 「未来酒店·智慧监控」小程序
 */
page {
  --brand: #1976d2;
  --brand-light: #e8f2fd;
  --success: #4caf50;
  --danger: #e54545;
  --warn: #ff976a;
  --text-1: #1f2937;
  --text-2: #5b6673;
  --text-3: #9aa4b0;
  --line: #ebedf0;
  --bg: #f4f7fb;

  background-color: var(--bg);
  color: var(--text-1);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'Segoe UI', Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB',
    'Microsoft Yahei', sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 通用卡片 ---------- */
.card {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 41, 55, 0.05);
  box-sizing: border-box;
}

.card--flush {
  padding: 0;
  overflow: hidden;
}

/* 卡片标题：左侧蓝色竖条 */
.card-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}

.card-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  margin-right: 14rpx;
  border-radius: 4rpx;
  background-color: var(--brand);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

/* ---------- 状态胶囊 ---------- */
.pill {
  display: inline-block;
  min-width: 120rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.6;
}

.pill--on {
  color: var(--success);
  background-color: rgba(76, 175, 80, 0.14);
}

.pill--off {
  color: var(--danger);
  background-color: rgba(229, 69, 69, 0.12);
}

.pill--muted {
  color: var(--text-3);
  background-color: rgba(154, 164, 176, 0.16);
}

/* ---------- 排版工具 ---------- */
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-muted {
  color: var(--text-3);
  font-size: 24rpx;
}

.text-center {
  text-align: center;
}

.mt-8 {
  margin-top: 8rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mt-32 {
  margin-top: 32rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

.page-bottom-space {
  height: 48rpx;
}
