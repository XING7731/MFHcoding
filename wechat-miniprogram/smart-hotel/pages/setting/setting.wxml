<!--pages/setting/setting.wxml  云端 / 阈值 / 房间配置-->
<view class="page">

  <!-- ========== 云端连接 ========== -->
  <view class="card">
    <view class="card-title mb-24">云端连接</view>

    <van-field
      value="{{form.uid}}"
      label="巴法云私钥"
      placeholder="控制台「个人中心」获取"
      data-field="uid"
      bind:change="onTextChange"
      input-align="right"
    />

    <view class="setting-row">
      <text class="setting-row__label">协议类型</text>
      <van-stepper
        value="{{form.deviceType}}"
        min="{{1}}"
        max="{{5}}"
        async-change
        data-field="deviceType"
        bind:change="onNumberChange"
      />
    </view>

    <view class="setting-row">
      <text class="setting-row__label">轮询周期（ms）</text>
      <van-stepper
        value="{{form.pollInterval}}"
        min="{{1000}}"
        max="{{10000}}"
        step="{{500}}"
        async-change
        data-field="pollInterval"
        bind:change="onNumberChange"
      />
    </view>

    <view class="hint">
      本项目配套 STM32 设备使用 TCP 协议，协议类型填 3；轮询周期越小数据越实时，但请求更频繁。
    </view>
  </view>

  <!-- ========== 告警阈值 ========== -->
  <view class="card">
    <view class="card-title mb-24">告警阈值</view>

    <view class="setting-row" wx:for="{{alarmRows}}" wx:key="field">
      <view class="setting-row__label">
        <text>{{item.label}}</text>
        <text class="setting-row__unit" wx:if="{{item.unit}}">（{{item.unit}}）</text>
      </view>
      <van-stepper
        value="{{form[item.field]}}"
        min="{{item.min}}"
        max="{{item.max}}"
        step="{{item.step}}"
        async-change
        data-field="{{item.field}}"
        bind:change="onNumberChange"
      />
    </view>

    <view class="hint">
      温度越界、湿度偏离设定值超过「湿度偏差」时首页会弹出告警。「烟雾阈值」为 0 表示不启用烟雾告警。
    </view>
  </view>

  <!-- ========== 数据展示 ========== -->
  <view class="card">
    <view class="card-title mb-24">数据展示</view>

    <view class="setting-row" wx:for="{{trendRows}}" wx:key="field">
      <view class="setting-row__label">
        <text>{{item.label}}</text>
        <text class="setting-row__unit" wx:if="{{item.unit}}">（{{item.unit}}）</text>
      </view>
      <van-stepper
        value="{{form[item.field]}}"
        min="{{item.min}}"
        max="{{item.max}}"
        step="{{item.step}}"
        async-change
        data-field="{{item.field}}"
        bind:change="onNumberChange"
      />
    </view>
  </view>

  <!-- ========== 房间列表 ========== -->
  <view class="card">
    <view class="card-head">
      <view class="card-title">房间列表</view>
      <text class="text-muted">共 {{form.rooms.length}} 个</text>
    </view>

    <view class="room-row" wx:for="{{form.rooms}}" wx:key="id">
      <view class="room-row__main">
        <view class="room-row__name">
          <text>{{item.name}}</text>
          <text class="room-row__badge" wx:if="{{item.id === form.activeRoomId}}">当前</text>
        </view>
        <text class="room-row__topic">温湿度 {{item.infoTopic}} · 控制 {{item.ctrlTopic}}</text>
      </view>
      <view class="room-row__ops">
        <text class="op" data-index="{{index}}" bindtap="startEditRoom">编辑</text>
        <text
          class="op op--danger"
          wx:if="{{form.rooms.length > 1}}"
          data-index="{{index}}"
          bindtap="removeRoom"
        >删除</text>
      </view>
    </view>

    <!-- 编辑面板 -->
    <view class="editor" wx:if="{{editing}}">
      <view class="editor__title">{{editingIsNew ? '新增房间' : '编辑房间'}}</view>
      <van-field
        value="{{roomForm.name}}"
        label="房间名称"
        placeholder="如：客房 8801"
        data-field="name"
        bind:change="onRoomFormChange"
      />
      <van-field
        value="{{roomForm.infoTopic}}"
        label="温湿度主题"
        placeholder="如：Smart"
        data-field="infoTopic"
        bind:change="onRoomFormChange"
      />
      <van-field
        value="{{roomForm.ctrlTopic}}"
        label="控制主题"
        placeholder="如：SmartCtrl"
        data-field="ctrlTopic"
        bind:change="onRoomFormChange"
      />
      <view class="editor__ops">
        <view class="editor__op">
          <van-button size="small" plain bind:click="cancelEditRoom">取消</van-button>
        </view>
        <view class="editor__op">
          <van-button size="small" type="primary" bind:click="saveRoom">确定</van-button>
        </view>
      </view>
    </view>

    <van-button
      wx:if="{{!editing}}"
      size="small"
      block
      plain
      type="primary"
      bind:click="startAddRoom"
    >+ 新增房间</van-button>

    <view class="hint">
      每个房间对应巴法云上的一组主题：温湿度主题用于接收下位机上报，控制主题用于下发灯光与加湿器指令。
    </view>
  </view>

  <!-- ========== 危险操作 ========== -->
  <view class="card">
    <van-button size="small" block plain type="danger" bind:click="resetConfig">
      恢复默认配置
    </van-button>
  </view>

  <view class="save-space"></view>

  <!-- ========== 底部保存条 ========== -->
  <view class="save-bar">
    <van-button type="primary" block round bind:click="saveConfig">保存配置</van-button>
  </view>
</view>
