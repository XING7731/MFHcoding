/* pages/setting/setting.wxss */

.page {
  min-height: 100vh;
  padding-bottom: 24rpx;
  box-sizing: border-box;
}

/* ---------------- 数值设置行 ---------------- */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.setting-row__label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-2);
}

.setting-row__unit {
  font-size: 24rpx;
  color: var(--text-3);
}

.hint {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-3);
  background-color: #f7f9fc;
  border-radius: 12rpx;
}

/* ---------------- 房间列表 ---------------- */
.room-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.room-row:last-of-type {
  border-bottom: none;
}

.room-row__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}

.room-row__name {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: var(--text-1);
}

.room-row__badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: var(--brand);
  background-color: var(--brand-light);
  border-radius: 8rpx;
}

.room-row__topic {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.room-row__ops {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.op {
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  color: var(--brand);
}

.op--danger {
  color: var(--danger);
}

/* ---------------- 编辑面板 ---------------- */
.editor {
  margin-top: 20rpx;
  padding: 24rpx;
  background-color: #f7f9fc;
  border-radius: 16rpx;
}

.editor__title {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.editor__ops {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.editor__op + .editor__op {
  margin-left: 20rpx;
}

/* ---------------- 底部保存条 ---------------- */
.save-space {
  height: 160rpx;
}

.save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -2rpx 16rpx rgba(31, 41, 55, 0.06);
}
